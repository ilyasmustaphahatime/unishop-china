{
  "info": {
    "name": "UniShop Phase 3 Phone Verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "testPhone", "value": "" },
    { "key": "verificationCode", "value": "" }
  ],
  "item": [
    {
      "name": "Register with phone",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"password\": \"ChangeThisPassword123\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created with safe JSON', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); const b=pm.response.json(); pm.expect(b).not.to.have.property('otp'); pm.expect(b).not.to.have.property('code_hash'); });"] } }]
    },
    {
      "name": "Resend verification code",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/resend-code" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Accepted without OTP', () => { pm.response.to.have.status(202); const b=pm.response.json(); pm.expect(b).not.to.have.property('otp'); pm.expect(b).not.to.have.property('code_hash'); });"] } }]
    },
    {
      "name": "Verify code",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"code\": \"{{verificationCode}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/verify", "description": "After an explicitly approved real SMS test, enter the received code manually in verificationCode." },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Phone verified', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().phone_verified).to.eql(true); });"] } }]
    },
    {
      "name": "Verify wrong code",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"code\": \"000000\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/verify" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Safe business error', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().detail.code).to.eql('INVALID_VERIFICATION_CODE'); });"] } }]
    },
    {
      "name": "Verify expired code",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"code\": \"{{verificationCode}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/verify" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Expired code rejected', () => pm.response.to.have.status(410));"] } }]
    },
    {
      "name": "Verify invalid format",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"code\": \"12345\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/verify" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Schema rejects invalid format', () => pm.response.to.have.status(422));"] } }]
    },
    {
      "name": "Resend during cooldown",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/resend-code" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cooldown enforced', () => { pm.response.to.have.status(429); pm.expect(pm.response.json().detail.code).to.eql('VERIFICATION_CODE_RATE_LIMITED'); });"] } }]
    },
    {
      "name": "Resend after hourly limit",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/resend-code" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Hourly limit enforced', () => pm.response.to.have.status(429));"] } }]
    },
    {
      "name": "Unknown-phone resend",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/resend-code" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Generic unknown response', () => { pm.response.to.have.status(202); pm.expect(pm.response.json().message).to.eql('If this phone number is eligible, a verification code will be sent.'); });"] } }]
    },
    {
      "name": "Already-verified phone",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{testPhone}}\",\n  \"code\": \"000000\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/phone/verify" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Already verified is idempotent', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().phone_verified).to.eql(true); });"] } }]
    }
  ]
}
