# Local secrets. Keep the documented placeholder template only.
.env
.env.*
!.env.example

# Python environments and generated bytecode.
.venv/
venv/
**/__pycache__/
*.py[cod]

# Test, lint, type-check, and coverage artifacts.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Repository and development-only content.
.git/
.gitignore
tests/
documentation/
*.log

# Runtime/private data must be mounted or provisioned at runtime.
uploads/
private_uploads/

# Local editor and operating-system artifacts.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
