TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGNATURE=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
SMS_REQUEST_TIMEOUT_SECONDS=10
ENABLE_FAKE_SMS_DEV_INBOX=false
FAKE_SMS_DELIVERY_DELAY_SECONDS=3
FAKE_SMS_INBOX_TTL_SECONDS=600
FAKE_SMS_INBOX_MAX_MESSAGES=100
FAKE_SMS_LOCALHOST_ONLY=true
REGISTRATION_RATE_LIMIT_REQUESTS=20
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT_MAX_CLIENTS=10000
LOGIN_IP_RATE_LIMIT_REQUESTS=5
