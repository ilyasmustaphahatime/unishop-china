APP_NAME=UniShop China
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unishop_china
MYSQL_USER=unishop_app
MYSQL_PASSWORD=replace_with_local_password

# Optional override. Leave empty to safely build the URL from MYSQL_* values.
DATABASE_URL=

JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
VERIFICATION_CODE_HASH_SECRET=replace_with_secure_verification_code_hash_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

MAX_PRODUCT_IMAGES=8
MAX_UPLOAD_SIZE_MB=8
SELLER_CODE_EXPIRY_MINUTES=10
PHONE_OTP_EXPIRY_MINUTES=10
