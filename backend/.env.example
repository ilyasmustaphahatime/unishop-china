APP_NAME=UniShop China
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unishop_china
MYSQL_USER=unishop_app
MYSQL_PASSWORD=replace_with_local_password

# Optional override. Leave empty to safely build the URL from MYSQL_* values.
DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=unishop-china-api
JWT_AUDIENCE=unishop-china-web
JWT_CLOCK_SKEW_SECONDS=30
VERIFICATION_CODE_HASH_SECRET=replace_with_secure_verification_code_hash_secret
PASSWORD_RESET_CODE_EXPIRY_MINUTES=10
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_HOURLY_LIMIT_REQUESTS=5
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_DELIVERY_PROVIDER=disabled
ENABLE_FAKE_PASSWORD_RESET_DEV_INBOX=false
FAKE_PASSWORD_RESET_DELIVERY_DELAY_SECONDS=0
FAKE_PASSWORD_RESET_INBOX_TTL_SECONDS=600
FAKE_PASSWORD_RESET_INBOX_MAX_MESSAGES=100
FAKE_PASSWORD_RESET_LOCALHOST_ONLY=true
EMAIL_VERIFICATION_CODE_EXPIRY_MINUTES=10
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_HOURLY_LIMIT_REQUESTS=5
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_DELIVERY_PROVIDER=disabled
ENABLE_FAKE_EMAIL_VERIFICATION_DEV_INBOX=false
FAKE_EMAIL_VERIFICATION_DELIVERY_DELAY_SECONDS=0
FAKE_EMAIL_VERIFICATION_INBOX_TTL_SECONDS=600
FAKE_EMAIL_VERIFICATION_INBOX_MAX_MESSAGES=100
FAKE_EMAIL_VERIFICATION_LOCALHOST_ONLY=true
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_ABSOLUTE_DAYS=30
REFRESH_COOKIE_NAME=unishop_refresh_token
CSRF_COOKIE_NAME=unishop_csrf_token
# Local HTTP only. Production must set this to true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
CSRF_COOKIE_PATH=/
MAX_ACTIVE_SESSION_FAMILIES_PER_USER=10

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_ENABLED=false
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=
